        {
          "key": "system",
          "label": "System",
          "type": "select",
          "requiredForPublic": true,
          "showInPublicDatasetTable": true,
          "options": ["CLAMS", "TSE", "Sable"],
          "placeholder": "Select"
        },
        {
          "key": "pmid",
          "label": "PMID",
          "type": "text",
          "showInPublicDatasetTable": false,
          "placeholder": "PubMed ID"
        }
      ]
    },
    {
      "title": "Biology",
      "fields": [
        {
          "key": "species",
          "label": "Species",
          "type": "selectOrText",
          "requiredForPublic": true,
          "showInPublicDatasetTable": true,
          "options": ["Mouse", "Rat", "Human"],
          "placeholder": "Select"
        },
        {
          "key": "tissue",
          "label": "Tissue",
          "type": "selectOrText",
          "requiredForPublic": true,
          "showInPublicDatasetTable": true,
          "options": ["Whole body", "BAT", "WAT"],
          "placeholder": "Select"
        },
        {
          "key": "strain",
          "label": "Strain",
          "type": "text",
          "requiredForPublic": true,
          "showInPublicDatasetTable": true,
          "placeholder": "e.g. GDF3KO"
        },
        {
          "key": "genetic_background",
          "label": "Genetic Background",
          "type": "text",
          "requiredForPublic": true,
          "showInPublicDatasetTable": true,
          "placeholder": "e.g. C57Bl/6"
        },
        {
          "key": "sex",
          "label": "Sex",
          "type": "selectOrText",
          "requiredForPublic": true,
          "showInPublicDatasetTable": true,
          "options": ["Female", "Male", "Both"],
          "placeholder": "Select"
        },
        {
          "key": "age",
          "label": "Age",
          "type": "number",
          "requiredForPublic": true,
          "showInPublicDatasetTable": true,
          "placeholder": "",
          "step": "1"
        }
      ]
    },
    {
      "title": "Treatment & Environment",
      "fields": [
        {
          "key": "treatment",
          "label": "Treatment",
          "type": "text",
          "requiredForPublic": true,
          "showInPublicDatasetTable": true,
          "placeholder": "e.g. HFD for 10 weeks"
        },
        {
          "key": "litter",
          "label": "Litter Size",
          "type": "number",
          "requiredForPublic": true,
          "showInPublicDatasetTable": true,
          "placeholder": "",
          "step": "1"
        },
        {
          "key": "temperature",
          "label": "Ambient Temp C",
          "type": "number",
          "showInPublicDatasetTable": true,
          "placeholder": "",
          "step": "0.1"
        },
        {
          "key": "bedding",
          "label": "Bedding",
          "type": "selectOrText",
          "showInPublicDatasetTable": true,
          "options": ["Straw", "Corncob", "Paper", "Alpha Dry", "Aspen Woodchip", "Kiln-dried Pine Woodchip", "Spruce Woodchip", "Maple Woodchip", "Beech Woodchip", "None"],
          "placeholder": "Select"
        },
        {
          "key": "enrich",
          "label": "Enrichment",
          "type": "selectOrText",
          "showInPublicDatasetTable": true,
          "options": ["None", "Running Wheel", "Igloo (Plastic)", "Igloo (Paper)"],
          "placeholder": "Select"
        },
        {
          "key": "ee_calc",
          "label": "EE Calc",
          "type": "selectOrText",
          "showInPublicDatasetTable": true,
          "options": ["Weir", "Lusk", "Kleiber"],
          "placeholder": "Select"
        }
      ]
    }
