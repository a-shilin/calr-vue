{
  "datasetTable": {
    "baseFields": [
      {
        "key": "name",
        "label": "Name",
        "showInPublicDatasetTable": true
      },
      {
        "key": "description",
        "label": "Description",
        "showInPublicDatasetTable": true
      },
      {
        "key": "uploaded_at",
        "label": "Uploaded",
        "showInPublicDatasetTable": false
      },
      {
        "key": "actions",
        "label": "Actions",
        "showInPublicDatasetTable": true
      }
    ]
  },
  "sections": [
    {
      "title": "Study Setup",
      "fields": [
        {
          "key": "experiment_id",
          "label": "Experiment ID",
          "type": "text",
          "requiredForPublic": true,
          "showInPublicDatasetTable": true,
          "placeholder": ""
        },
        {
          "key": "investigator",
          "label": "Investigator",
          "type": "text",
          "requiredForPublic": true,
          "showInPublicDatasetTable": true,
          "placeholder": "Lastname, Firstname"
        },
        {
          "key": "location",
          "label": "Location",
          "type": "text",
          "requiredForPublic": true,
          "showInPublicDatasetTable": true,
          "placeholder": "Institution or site"
