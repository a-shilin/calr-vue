        "placeholder": "Select"
      },
      {
        "key": "enrich",
        "label": "Enrichment",
        "type": "selectOrText",
        "options": ["None", "Running Wheel", "Igloo (Plastic)", "Igloo (Paper)"],
        "placeholder": "Select"
      },
      {
        "key": "ee_calc",
        "label": "EE Calc",
        "type": "selectOrText",
        "options": ["Weir", "Lusk", "Kleiber"],
        "placeholder": "Select"
